# Copy to vps.env on the VPS and replace every CHANGE_ME value.
POSTGRES_DB=catws_music
POSTGRES_USER=catws_app
POSTGRES_PASSWORD=CHANGE_ME_LONG_DATABASE_PASSWORD

APP_NAME=Catws Music API
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
ACCESS_TOKEN_MINUTES=1440
DATABASE_URL=postgresql+psycopg://catws_app:CHANGE_ME_LONG_DATABASE_PASSWORD@db:5432/catws_music
PUBLIC_BASE_URL=https://api.example.com
CORS_ORIGINS=https://admin.example.com

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
ADMIN_SYNC_PASSWORD=false
MAX_AUDIO_MB=80
MAX_IMAGE_MB=8

# Production media never uses the VPS filesystem.
STORAGE_BACKEND=s3
S3_BUCKET=catws-media
S3_REGION=auto
S3_ENDPOINT_URL=https://YOUR-S3-ENDPOINT
S3_ACCESS_KEY_ID=CHANGE_ME_STORAGE_ACCESS_KEY
S3_SECRET_ACCESS_KEY=CHANGE_ME_STORAGE_SECRET_KEY
S3_PUBLIC_BASE_URL=https://YOUR-PUBLIC-STORAGE-DOMAIN
