APP_NAME=Catws Music API
ENVIRONMENT=production

# Use a percent-encoded password when it contains URL-reserved characters.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# SECRET_KEY is authoritative. JWT_SECRET is a legacy fallback only.
SECRET_KEY=
ACCESS_TOKEN_MINUTES=1440

STORAGE_BACKEND=cloudinary
CLOUDINARY_CLOUD_NAME=b2stvlkr
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PUBLIC_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com

ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SYNC_PASSWORD=false
MAX_AUDIO_MB=50
MAX_IMAGE_MB=8
CORS_ORIGINS=*
